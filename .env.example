# Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://fh:fh_dev_password@localhost:5433/fh

# Redis
REDIS_URL=redis://localhost:6379

# JWT — change ALL of these before deploying
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# AWS S3 (private documents)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Cloudflare R2 (public media)
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET=
CF_R2_ENDPOINT=
CF_R2_PUBLIC_BASE_URL=

# Local dev uploads root (used when cloud creds absent)
LOCAL_UPLOADS_ROOT=./uploads

# Seeding
SEED_SUPERADMIN_EMAIL=admin@fhplatform.com
SEED_SUPERADMIN_PASSWORD=change-me-before-use
SEED_SUPERADMIN_NAME=Super Admin

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
